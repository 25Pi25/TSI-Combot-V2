{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "jsx": "react",
        "rootDir": "./src/",
        "outDir": "./dist/",
        "strict": true,
        "importHelpers": true,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "removeComments": true,
        "typeRoots": [
            "node_modules/@types"
        ],
        "sourceMap": false
    },
    "files": [
        "src/index.ts"
    ],
    "include": [
        "./**/*.ts"
, "src/index.ts"    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
}